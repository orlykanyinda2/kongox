# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais envoyer .env.local sur GitHub.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

API_FOOTBALL_KEY=
ANTHROPIC_API_KEY=

# Numéro WhatsApp de l'équipe (format international, ex. 243812345678) pour « Mot de passe oublié ? »
NEXT_PUBLIC_WHATSAPP_EQUIPE=

# Adresse publique du site (liens de partage), ex. https://kongox.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de l'import planifié des matchs (Vercel Cron envoie « Authorization: Bearer <CRON_SECRET> »)
CRON_SECRET=

# Tests seulement (tests/lancer.py) : connexion PostgreSQL directe à la base de DÉVELOPPEMENT.
# À mettre dans une variable d'environnement de ta session, pas dans .env.local, et jamais en production.
# KX_DB_URL=postgresql://postgres:<mot de passe de la base>@db.<projet>.supabase.co:5432/postgres
